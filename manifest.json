{
  "manifest_version": 3,
  "name": "PageCub",
  "version": "1.0.0",
  "description": "Save any webpage as PDF or Markdown. Clean downloads, no clutter.",

  
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png", 
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/icon-48.png",
        "icons/icon-happy.png",
        "icons/icon-sad.png",
        "icons/icon-happier.png",
        "icons/threadcub-logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting",
    "cookies"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
  {
    "matches": [
      "<all_urls>"
    ],
    "css": [
      "assets/tokens.css",
      "assets/floating-button.css",
      "assets/side-panel.css"
    ],
    "js": [
      "src/utils/utilities.js",
      "src/utils/design-tokens.js",
      "src/services/storage-service.js",
      "src/ui/ui-components.js",
      "src/core/page-extractor.js",
      "src/features/download-manager.js",
      "src/features/tagging-system.js",
      "src/ui/side-panel.js",
      "src/core/floating-button.js",
      "src/core/app-initializer.js",
      "content.js"
    ],
    "run_at": "document_idle"
  }
],
  
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PageCub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "homepage_url": "https://pagecub.com"
}